# next-auth@4 declares nodemailer ^7.0.7 as a peerOptional dependency, but this
# app runs nodemailer ^8 for survey email. The peer is only used by next-auth's
# Email provider, which we don't use (Google provider only), so the conflict is
# inert at runtime.
#
# npm 11 tolerates it; npm 10 (shipped in the node:18-alpine build image) fails
# `npm ci` with ERESOLVE. Pinning the flag here rather than passing it on the
# command line keeps local installs, CI, and the Docker build resolving the
# lockfile identically -- the mismatch is what let an unbuildable lockfile get
# committed in the first place.
legacy-peer-deps=true
